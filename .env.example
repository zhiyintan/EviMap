# Export these values in the shell before running a pipeline.
CATALOGUE_LLM_BASE_URL=http://127.0.0.1:18021/v1
CATALOGUE_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
CATALOGUE_LLM_API_KEY=local
CATALOGUE_LLM_WORKERS=128
CATALOGUE_LLM_ENABLE_THINKING=false
CATALOGUE_LLM_TIMEOUT_S=180
CATALOGUE_LLM_STALL_S=120
# Requests, responses, usage and failures are recorded here; keys are excluded.
CATALOGUE_LLM_AUDIT_LOG=runs/llm_calls.jsonl
